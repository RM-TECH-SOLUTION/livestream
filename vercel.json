{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:eventId/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|WhatsApp|Twitterbot|Xbot|LinkedInBot|Slackbot|Discordbot|TelegramBot|SkypeUriPreview|Googlebot|bingbot|DuckDuckBot|Yahoo! Slurp|embedly|quora link preview|pinterest|vkShare|W3C_Validator).*"
        }
      ],
      "destination": "/api/:eventId/:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
